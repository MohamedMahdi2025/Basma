<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, trusting only the system certificate authorities: a certificate installed by the user (or an interception
     tool) is not trusted, so traffic cannot be read by a proxy on the phone. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
